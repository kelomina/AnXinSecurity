  <!--
    链接库说明 / Link library notes:
      fwpkclnt.lib - WFP 内核态 API（Fwps* 与 Fwpm*）
      ndis.lib     - NET_BUFFER 访问（NdisGetDataBuffer）
      wdmsec.lib   - IoCreateDeviceSecure
      uuid.lib     - FWPM_LAYER_* / FWPM_CONDITION_* GUID 常量
    注意 NDIS6_SUPPORT 相关宏必须与 fwpsk.h 的要求一致，否则结构体版本不匹配。
    NDIS6_SUPPORT macros must match what fwpsk.h expects or structure versions
    will silently disagree.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(ProjectDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_DEBUG;DBG=1;NDIS_SUPPORT_NDIS6=1;NDIS630=1;POOL_NX_OPTIN=1;NTDDI_VERSION=0x0A00000B;_NT_TARGET_VERSION=0x0A00000B;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>fwpkclnt.lib;ndis.lib;wdmsec.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(ProjectDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;NDIS_SUPPORT_NDIS6=1;NDIS630=1;POOL_NX_OPTIN=1;NTDDI_VERSION=0x0A00000B;_NT_TARGET_VERSION=0x0A00000B;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>fwpkclnt.lib;ndis.lib;wdmsec.lib;uuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

