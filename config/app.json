  "ui": {
    "animations": true,
    "themeMode": "system",
    "window": {
      "minWidth": 800,
      "minHeight": 600
    }
  },
  "scanner": {
    "timeoutMs": 5000,
    "healthPollIntervalMs": 3000,
    "tuningEnabled": true,
    "maxFileSizeMB": 300,
    "signatureDbPath": "data/anxin_signature_db.bin",
    "nativeDll": {
      "enabled": true,
      "prefer": true
