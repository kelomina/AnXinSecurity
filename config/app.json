{
  "behaviorAnalyzer": {
    "enabled": true,
    "flushIntervalMs": 500,
    "sqlite": {
      "directory": "data/behavior",
      "fileName": "anxin_etw_behavior.db",
      "mode": "file"
    }
  },
  "behaviorMonitoring": {
    "enabled": true
  },
  "brand": "AnXin Security",
  "defaultPage": "overview",
  "fileMonitoring": {
    "enabled": true
  },
  "hypervisorProtection": {
    "enabled": false
  },
  "locale": "zh-CN",
  "minimizeToTray": true,
  "networkFirewall": {
    "allowLoopback": true,
    "cacheTtlMs": 300000,
    "contentInspection": false,
    "defaultInbound": "allow",
    "defaultOutbound": "allow",
    "dnsFiltering": false,
    "enabled": false,
    "mode": "silent",
    "promptTimeoutMs": 20000,
    "rateLimiting": false,
    "timeoutAction": "allow",
    "trafficStats": true
  },
  "processMonitoring": {
    "enabled": true
  },
  "scan": {
    "commonExtensionsOnly": false
  },
  "scanner": {
    "healthPollIntervalMs": 30000,
    "ipc": {
      "connectTimeoutMs": 500,
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8765,
      "prefer": false,
      "timeoutMs": 10000
    },
    "maxFileSizeMB": 500,
    "startupModuleEnumerationTimeoutMs": 1000,
    "startupRevocationCheckConcurrency": 4,
    "startupRevocationCheckTimeoutMs": 5000,
    "startupSignatureVerifyConcurrency": 0,
    "startupSignatureVerifyTimeoutMs": 1000,
    "startupSnapshotSlowWarnMs": 30000,
    "timeoutMs": 10000
  },
  "tray": {
    "exitKeepScannerServiceDefault": true,
    "exitKeepScannerServicePrompt": true
  },
  "ui": {
    "animations": true,
    "themeMode": "system",
    "window": {
      "minHeight": 600,
      "minWidth": 800
    }
  }
}