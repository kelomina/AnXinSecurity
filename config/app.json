  "etw": {
    "enabled": true,
    "sessionName": "AnXinSecuritySession",
    "userDataMaxBytes": 52428800,
    "stopTimeoutMs": 2500,
    "startRetries": 2,
    "retryDelayMs": 150,
    "emitRegistryRawHex": false,
    "providers": {
      "Process": {
        "anyKeyword": "0x0",
        "allKeyword": "0x0"
      },
      "File": {
        "anyKeyword": "0xFFFFFFFFFFFFFFFF",
        "allKeyword": "0x0"
      },
      "Registry": {
        "anyKeyword": "0x0",
        "allKeyword": "0x0"
      },
      "Network": {
        "anyKeyword": "0x0",
        "allKeyword": "0x0"
      }
    },
    "logToConsole": true,
    "logParsedToConsole": true,
    "resolveProcessName": true,
    "processNameCacheMax": 2048,
    "processNameCacheTtlMs": 300000,
    "processNameResolveMaxPerSecond": 20,
    "consoleMaxPerSecond": 200,
    "pidSnapshot": {
      "enabled": true,
      "maxPids": 8192
    },
    "filters": {
      "trustedPid": {
        "enabled": true,
        "applyToSnapshot": true,
        "applyToNewProcesses": true,
        "maxVerifyPids": 0,
        "skipProviders": [
          "Registry",
          "Network"
        ],
        "userTrustedPaths": [],
        "baseTrustedPids": [
          0,
          4
        ],
        "extraTrustedPids": []
      },
      "Registry": {
        "skipOps": [
          "OpenKey",
          "CloseKey",
          "QueryKey"
        ]
      },
      "Process": {
        "skipOps": []
      },
      "File": {
        "skipOps": []
      },
      "Network": {
        "skipOps": []
      }
    },
    "network": {
      "enabled": true,
      "filterPrivateIps": true,
      "skipLoopback": true
    },
    "matching": {
      "rulesFile": "config/etw_match_rules.json",
      "contextPerPid": 100,
      "includeChildren": true
    },
    "interception": {
      "enabled": true,
      "snapshotVerifyOnEtwStart": true,
      "snapshotTrustThreshold": 3,
      "snapshotMaxPids": 8192,
      "modulesBufferBytes": 65536,
      "skipSystemDll": true,
      "maxUnsignedDllsPerProcess": 16
    }
  },
  "behaviorAnalyzer": {
    "enabled": true,
    "flushIntervalMs": 100,
    "sqlite": {
      "mode": "file",
      "directory": "data/behavior",
