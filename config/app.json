    "tuning": {
      "fastLatencyMs": 700,
      "slowLatencyMs": 2000,
      "minPoolSize": 8,
      "maxPoolSize": 256,
      "minRatePerSecond": 8,
      "maxRatePerSecond": 256,
      "adjustStep": 8
    },
    "maxTokens": 16,
    "ipc": {
      "enabled": false,
      "prefer": false,
      "host": "127.0.0.1",
      "port": 8765,
      "connectTimeoutMs": 500,
      "timeoutMs": 5000
