{
  "behaviorAnalyzer": {
    "enabled": true,
    "flushIntervalMs": 500,
    "sqlite": {
      "directory": "data/behavior",
      "fileName": "anxin_etw_behavior.db",
      "mode": "file"
    }
  },
  "behaviorMonitoring": {
    "enabled": false
  },
  "brand": "AnXin Security",
  "defaultPage": "overview",
  "fileMonitoring": {
    "enabled": true
  },
  "minimizeToTray": true,
  "processMonitoring": {
    "enabled": true
  },
  "scan": {
    "commonExtensionsOnly": false
  },
  "scanner": {
    "healthPollIntervalMs": 30000,
    "ipc": {
      "connectTimeoutMs": 500,
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8765,
      "prefer": false,
      "timeoutMs": 10000
    },
    "maxFileSizeMB": 500,
    "timeoutMs": 10000
  },
  "themeColor": "#4CA2FF",
  "tray": {
    "exitKeepScannerServiceDefault": true,
    "exitKeepScannerServicePrompt": true
  },
  "ui": {
    "animations": true,
    "themeMode": "system",
    "window": {
      "minHeight": 600,
      "minWidth": 800
    }
  }
}